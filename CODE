
#include <WiFi.h>
#include <ThingSpeak.h>
#include <DHT.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// WiFi credentials
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

// ThingSpeak details
unsigned long channelID = YOUR_CHANNEL_ID;
const char* writeAPIKey = "YOUR_WRITE_API_KEY";

// Sensor pins
#define MQ135_PIN 34
#define DHT_PIN 4
#define DHT_TYPE DHT11

// Initialize sensors and display
DHT dht(DHT_PIN, DHT_TYPE);
LiquidCrystal_I2C lcd(0x27, 16, 2);

WiFiClient client;

// Gas thresholds (calibrate for your sensor)
#define GAS_GOOD_MAX 1000
#define GAS_FAIR_MAX 1800
#define GAS_POOR_MAX 2600

String foodStatus;
int statusCode;

void setup() {
  Serial.begin(115200);

  dht.begin();
  lcd.init();
  lcd.backlight();

  lcd.setCursor(0, 0);
  lcd.print("Food Spoilage");
  lcd.setCursor(0, 1);
  lcd.print("Detection System");

  delay(2000);
  lcd.clear();

  // Connect to WiFi
  WiFi.begin(ssid, password);

  lcd.setCursor(0, 0);
  lcd.print("Connecting WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi Connected!");

  ThingSpeak.begin(client);

  lcd.clear();
  lcd.print("System Ready");
  delay(1500);
  lcd.clear();
}

void loop() {

  // Read sensor values
  int gasValue = analogRead(MQ135_PIN);
  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();

  // Check DHT sensor
  if (isnan(temperature) || isnan(humidity)) {
    Serial.println("DHT Sensor Error");
    lcd.clear();
    lcd.print("DHT Sensor Error");
    delay(2000);
    return;
  }

  // Food quality classification
  if (gasValue <= GAS_GOOD_MAX) {
    foodStatus = "GOOD";
    statusCode = 1;
  }
  else if (gasValue <= GAS_FAIR_MAX) {
    foodStatus = "FAIR";
    statusCode = 2;
  }
  else if (gasValue <= GAS_POOR_MAX) {
    foodStatus = "POOR";
    statusCode = 3;
  }
  else {
    foodStatus = "VERY POOR";
    statusCode = 4;
  }

  // Serial Monitor output
  Serial.println("--------------------");
  Serial.print("Gas Value: ");
  Serial.println(gasValue);

  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" C");

  Serial.print("Humidity: ");
  Serial.print(humidity);
  Serial.println(" %");

  Serial.print("Food Quality: ");
  Serial.println(foodStatus);

  // LCD Display
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Quality: ");
  lcd.print(foodStatus);

  lcd.setCursor(0, 1);
  lcd.print("Gas:");
  lcd.print(gasValue);
  lcd.print(" T:");
  lcd.print(temperature, 0);

  // Upload data to ThingSpeak
  if (WiFi.status() == WL_CONNECTED) {

    ThingSpeak.setField(1, gasValue);
    ThingSpeak.setField(2, temperature);
    ThingSpeak.setField(3, humidity);
    ThingSpeak.setField(4, statusCode);

    int response = ThingSpeak.writeFields(
      channelID, writeAPIKey
    );

    if (response == 200) {
      Serial.println("ThingSpeak Upload Successful");
    }
    else {
      Serial.print("ThingSpeak Error: ");
      Serial.println(response);
    }
  }

  delay(20000); // Upload every 20 seconds
}
